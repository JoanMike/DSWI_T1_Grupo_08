@model DSWI_T1_Grupo_08.ViewModels.NotaFinalVm
@{
    ViewData["Title"] = "Nota final del instituto";
}

<div class="container mt-5">
    <h1 class="text-center">Nota final del instituto</h1>
    <p class="text-center text-muted">
        Ingresa las tres notas y el porcentaje de asistencia del estudiante.
    </p>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <form asp-controller="NotaFinal" asp-action="Index" method="post" class="card card-body shadow-sm mt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Entrada.nota1" class="form-label">Primera nota</label>
                        <input asp-for="Entrada.nota1" class="form-control" type="number" step="0.01" min="0" max="20"
                               placeholder="Ejemplo: 16" />
                        <span asp-validation-for="Entrada.nota1" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Entrada.nota2" class="form-label">Segunda nota</label>
                        <input asp-for="Entrada.nota2" class="form-control" type="number" step="0.01" min="0" max="20"
                               placeholder="Ejemplo: 18" />
                        <span asp-validation-for="Entrada.nota2" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Entrada.nota3" class="form-label">Tercera nota</label>
                        <input asp-for="Entrada.nota3" class="form-control" type="number" step="0.01" min="0" max="20"
                               placeholder="Ejemplo: 20" />
                        <span asp-validation-for="Entrada.nota3" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Entrada.porcentajeAsistencia" class="form-label">Asistencia (%)</label>
                        <input asp-for="Entrada.porcentajeAsistencia" class="form-control" type="number" step="0.01"
                               min="0" max="100" placeholder="Ejemplo: 85" />
                        <span asp-validation-for="Entrada.porcentajeAsistencia" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Calcular nota final</button>
            </form>
        </div>
    </div>

    @if (Model.Resultado != null)
    {
        var claseCategoria = Model.Resultado.categoria switch
        {
            "Excelente" => "bg-success",
            "Bueno" => "bg-primary",
            "Regular" => "bg-warning text-dark",
            _ => "bg-danger"
        };

        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-dark text-white">Resultado del estudiante</div>
                    <div class="card-body">
                        <div class="row text-center mb-3">
                            <div class="col-md-4">
                                <div class="text-muted small">Promedio</div>
                                <div class="display-6">@Model.Resultado.promedio.ToString("N2")</div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted small">Categoría</div>
                                <div class="mt-2">
                                    <span class="badge fs-5 @claseCategoria">@Model.Resultado.categoria</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-muted small">Beca</div>
                                <div class="display-6">@Model.Resultado.porcentajeBeca.ToString("N0")%</div>
                            </div>
                        </div>

                        <div class="progress bg-light border mb-3" role="progressbar" aria-label="Porcentaje de beca"
                             aria-valuenow="@Model.Resultado.porcentajeBeca" aria-valuemin="0" aria-valuemax="50"
                             style="height: 10px;">
                            <div class="progress-bar bg-success" style="width: @(Model.Resultado.porcentajeBeca)%;"></div>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-6">Asistencia</dt>
                            <dd class="col-sm-6 text-end">@Model.Resultado.porcentajeAsistencia.ToString("N2")%</dd>

                            <dt class="col-sm-6">Estado</dt>
                            <dd class="col-sm-6 text-end">
                                @if (Model.Resultado.asistenciaSuficiente)
                                {
                                    <span class="text-success">Asistencia suficiente</span>
                                }
                                else
                                {
                                    <span class="text-danger">Asistencia insuficiente (menor al 70%)</span>
                                }
                            </dd>
                        </dl>

                        @if (Model.Resultado.asistenciaSuficiente)
                        {
                            <div class="alert alert-info mb-0 mt-3">@Model.Resultado.observacion</div>
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0 mt-3">@Model.Resultado.observacion</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="accordion mt-4" id="reglasNotaFinal">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#tablaNotaFinal" aria-expanded="false" aria-controls="tablaNotaFinal">
                            Ver reglas de la nota final
                        </button>
                    </h2>
                    <div id="tablaNotaFinal" class="accordion-collapse collapse" data-bs-parent="#reglasNotaFinal">
                        <div class="accordion-body">
                            <table class="table table-bordered table-sm mb-3">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Promedio de los tres exámenes</th>
                                        <th>Categoría</th>
                                        <th>Beca</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>18 o más</td>
                                        <td>Excelente</td>
                                        <td>50%</td>
                                    </tr>
                                    <tr>
                                        <td>Entre 14 y 17.99</td>
                                        <td>Bueno</td>
                                        <td>25%</td>
                                    </tr>
                                    <tr>
                                        <td>Entre 11 y 13.99</td>
                                        <td>Regular</td>
                                        <td>Sin beca</td>
                                    </tr>
                                    <tr>
                                        <td>Menos de 11</td>
                                        <td>Reprobado</td>
                                        <td>Debe repetir el curso</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="mb-0 text-muted">
                                Si la asistencia es menor al 70%, el estudiante queda reprobado sin beca
                                sin importar su promedio.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
