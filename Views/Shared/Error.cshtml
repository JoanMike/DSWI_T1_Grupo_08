@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Ocurrió un error al procesar tu solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Id de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Si cambias al entorno <strong>Development</strong> se mostrará información más detallada del error.
</p>
<p>
    <strong>El entorno de desarrollo no debe habilitarse en aplicaciones publicadas.</strong>
    Puede mostrar información sensible de las excepciones a los usuarios finales.
    Para depurar localmente, habilita el entorno <strong>Development</strong> definiendo la variable de entorno
    <strong>ASPNETCORE_ENVIRONMENT</strong> con el valor <strong>Development</strong> y reinicia la aplicación.
</p>
